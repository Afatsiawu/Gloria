# Copy to .env at the repository root. Never commit real secrets.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database file (relative paths resolve from /server)
DB_PATH=./data/pharmacy.db

# Auth
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
COOKIE_SECURE=false

# Provider adapters: mock | paystack | hubtel | arkesel | mnotify | sendgrid | smtp
PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock

# Mock payment behaviour
MOCK_PAYMENT_FAILURE_RATE=0
MOCK_PAYMENT_DELAY_MS=4000

# Real provider placeholders (documented in README)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=PharmaLink
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=PharmaLink
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@pharmalink.gh
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@pharmalink.gh

# Operations
EXPIRY_ALERT_DAYS=90
FORECAST_WINDOW_WEEKS=4
FORECAST_LEAD_TIME_DAYS=7
SAFETY_STOCK_DAYS=3
BACKUP_RETENTION_DAYS=14
BACKUP_CRON=0 2 * * *
ENABLE_CRON=true
